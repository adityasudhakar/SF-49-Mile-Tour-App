{
  "name": "mv-native-audio-tour",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-react-native-boost.js",
    "start": "expo start --dev-client",
    "ios": "LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 expo run:ios --device",
    "pods": "cd ios && LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 pod _1.14.3_ install",
    "prebuild": "expo prebuild --platform ios",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.17.11",
    "@types/node": "18.19.123",
    "expo": "~48.0.21",
    "expo-av": "~13.2.1",
    "expo-location": "15.1.1",
    "expo-speech": "11.1.1",
    "expo-splash-screen": "~0.18.2",
    "expo-status-bar": "1.4.4",
    "expo-task-manager": "11.1.1",
    "react": "18.2.0",
    "react-native": "0.71.14"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "18.0.27",
    "typescript": "4.9.5"
  }
}
